<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="OptionsDialog" dlg:left="0" dlg:top="0" dlg:width="279" dlg:height="290" dlg:help-text="&amp;OptionsDialog.HelpText" dlg:closeable="true" dlg:moveable="true" dlg:title="&amp;OptionsDialog.Title" dlg:withtitlebar="false">
  <dlg:styles>
    <dlg:style dlg:style-id="0" dlg:font-weight="150"/>
  </dlg:styles>
  <dlg:bulletinboard>
    <dlg:titledbox dlg:id="FrameControl1" dlg:tab-index="0" dlg:left="0" dlg:top="0" dlg:width="279" dlg:height="60" dlg:help-text="&amp;OptionsDialog.FrameControl1.HelpText">
      <dlg:title dlg:value="&amp;OptionsDialog.FrameControl1.Label"/>
    </dlg:titledbox>
    <dlg:fixedline dlg:style-id="0" dlg:id="FixedLine1" dlg:left="5" dlg:top="60" dlg:width="268" dlg:height="15" dlg:help-text="&amp;OptionsDialog.FixedLine1.HelpText" dlg:value="&amp;OptionsDialog.FixedLine1.Label"/>
    <dlg:text dlg:id="Label1" dlg:left="10" dlg:top="80" dlg:width="190" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label1.HelpText" dlg:value="&amp;OptionsDialog.Label1.Label" dlg:valign="center"/>
    <dlg:numericfield dlg:id="NumericField1" dlg:tab-index="1" dlg:left="249" dlg:top="80" dlg:width="25" dlg:height="15" dlg:help-text="&amp;OptionsDialog.NumericField1.HelpText" dlg:decimal-accuracy="0" dlg:value-min="0" dlg:value-max="30"/>
    <dlg:text dlg:id="Label2" dlg:left="10" dlg:top="100" dlg:width="140" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label2.HelpText" dlg:value="&amp;OptionsDialog.Label2.Label" dlg:valign="center"/>
    <dlg:button dlg:id="CommandButton1" dlg:disabled="true" dlg:tab-index="2" dlg:left="184" dlg:top="100" dlg:width="90" dlg:height="15" dlg:help-text="&amp;OptionsDialog.CommandButton1.HelpText" dlg:value="&amp;OptionsDialog.CommandButton1.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowIspdb" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="Label3" dlg:left="10" dlg:top="120" dlg:width="140" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label3.HelpText" dlg:value="&amp;OptionsDialog.Label3.Label" dlg:valign="center"/>
    <dlg:button dlg:id="CommandButton2" dlg:disabled="true" dlg:tab-index="3" dlg:left="184" dlg:top="120" dlg:width="90" dlg:height="15" dlg:help-text="&amp;OptionsDialog.CommandButton2.HelpText" dlg:value="&amp;OptionsDialog.CommandButton2.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowDataBase" script:language="UNO"/>
    </dlg:button>
    <dlg:fixedline dlg:style-id="0" dlg:id="FixedLine2" dlg:left="5" dlg:top="140" dlg:width="268" dlg:height="15" dlg:help-text="&amp;OptionsDialog.FixedLine2.HelpText" dlg:value="&amp;OptionsDialog.FixedLine2.Label"/>
    <dlg:text dlg:id="Label4" dlg:left="10" dlg:top="160" dlg:width="60" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label4.HelpText" dlg:value="&amp;OptionsDialog.Label4.Label" dlg:valign="center"/>
    <dlg:menulist dlg:id="ListBox1" dlg:tab-index="4" dlg:left="84" dlg:top="160" dlg:width="45" dlg:height="15" dlg:help-text="&amp;OptionsDialog.ListBox1.HelpText" dlg:spin="true">
      <dlg:menupopup>
        <dlg:menuitem dlg:value="&amp;OptionsDialog.ListBox1.StringItemList.0"/>
        <dlg:menuitem dlg:value="&amp;OptionsDialog.ListBox1.StringItemList.1"/>
        <dlg:menuitem dlg:value="&amp;OptionsDialog.ListBox1.StringItemList.2"/>
      </dlg:menupopup>
    </dlg:menulist>
    <dlg:text dlg:id="Label5" dlg:left="184" dlg:top="160" dlg:width="60" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label5.HelpText" dlg:value="&amp;OptionsDialog.Label5.Label" dlg:valign="center"/>
    <dlg:numericfield dlg:id="NumericField2" dlg:tab-index="5" dlg:left="249" dlg:top="160" dlg:width="25" dlg:height="15" dlg:help-text="&amp;OptionsDialog.NumericField2.HelpText" dlg:decimal-accuracy="1" dlg:value-step="0.1" dlg:value-min="0.1" dlg:value-max="10"/>
    <dlg:text dlg:id="Label6" dlg:left="10" dlg:top="180" dlg:width="140" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label6.HelpText" dlg:value="&amp;OptionsDialog.Label6.Label" dlg:valign="center"/>
    <dlg:button dlg:id="CommandButton3" dlg:disabled="true" dlg:tab-index="6" dlg:left="184" dlg:top="180" dlg:width="90" dlg:height="15" dlg:help-text="&amp;OptionsDialog.CommandButton3.HelpText" dlg:value="&amp;OptionsDialog.CommandButton3.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowSpooler" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:id="Label7" dlg:left="10" dlg:top="200" dlg:width="140" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label7.HelpText" dlg:value="&amp;OptionsDialog.Label7.Label" dlg:valign="center"/>
    <dlg:button dlg:id="CommandButton4" dlg:disabled="true" dlg:tab-index="7" dlg:left="184" dlg:top="200" dlg:width="90" dlg:height="15" dlg:help-text="&amp;OptionsDialog.CommandButton4.HelpText" dlg:value="&amp;OptionsDialog.CommandButton4.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowController" script:language="UNO"/>
    </dlg:button>
    <dlg:titledbox dlg:id="FrameControl2" dlg:tab-index="8" dlg:left="0" dlg:top="220" dlg:width="279" dlg:height="40" dlg:help-text="&amp;OptionsDialog.FrameControl2.HelpText">
      <dlg:title dlg:value="&amp;OptionsDialog.FrameControl2.Label"/>
    </dlg:titledbox>
    <dlg:text dlg:style-id="0" dlg:id="Label8" dlg:tab-index="9" dlg:left="10" dlg:top="260" dlg:width="259" dlg:height="25" dlg:help-text="&amp;OptionsDialog.Label8.HelpText" dlg:value="&amp;OptionsDialog.Label8.Label" dlg:align="center" dlg:valign="center" dlg:multiline="true"/>
  </dlg:bulletinboard>
</dlg:window>

