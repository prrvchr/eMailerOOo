<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="SpoolerController" dlg:left="0" dlg:top="0" dlg:width="230" dlg:height="25" dlg:help-text="&amp;SpoolerController.HelpText" dlg:closeable="false" dlg:moveable="false" dlg:title="&amp;SpoolerController.Title" dlg:withtitlebar="false">
  <dlg:styles>
    <dlg:style dlg:style-id="0" dlg:font-weight="150"/>
  </dlg:styles>
  <dlg:bulletinboard>
    <dlg:button dlg:id="CommandButton1" dlg:tab-index="0" dlg:disabled="true" dlg:left="5" dlg:top="5" dlg:width="45" dlg:height="15" dlg:help-text="&amp;SpoolerController.CommandButton1.HelpText" dlg:value="&amp;SpoolerController.CommandButton1.Label.0" dlg:toggled="1">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ToggleSpooler" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:style-id="0" dlg:id="Label1" dlg:tab-index="1" dlg:left="55" dlg:top="5" dlg:width="65" dlg:height="15" dlg:help-text="&amp;SpoolerController.Label1.HelpText" dlg:value="&amp;SpoolerController.Label1.Label" dlg:align="center" dlg:valign="center"/>
    <dlg:button dlg:id="CommandButton2" dlg:tab-index="2" dlg:disabled="true" dlg:left="125" dlg:top="5" dlg:width="45" dlg:height="15" dlg:help-text="&amp;SpoolerController.CommandButton2.HelpText" dlg:value="&amp;SpoolerController.CommandButton2.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowSpooler" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="CommandButton3" dlg:tab-index="3" dlg:disabled="true" dlg:left="180" dlg:top="5" dlg:width="45" dlg:height="15" dlg:help-text="&amp;SpoolerController.CommandButton3.HelpText" dlg:value="&amp;SpoolerController.CommandButton3.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:CloseController" script:language="UNO"/>
    </dlg:button>
  </dlg:bulletinboard>
</dlg:window>

